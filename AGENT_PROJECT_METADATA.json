  "matchWorkflow": {
    "status": "Local mock workflow with server routes for balancing/validation. No database persistence yet.",
    "createMatchComponent": "components/matches/MockMatchEntryForm.tsx",
    "availability": {
      "state": "availablePlayerIds",
      "rules": [
        "Available Today checkboxes appear above Team A / Team B selectors.",
        "Unavailable players cannot be assigned to teams.",
        "Removing availability removes that player from Team A and Team B.",
        "Availability affects only the current match."
      ],
      "buttons": [
        "Select All",
        "Clear All",
        "Auto-Balance Teams",
        "Shuffle Again",
        "Clear Teams"
      ]
    },
    "manualTeamSelection": {
      "state": [
        "teamA",
        "teamB"
      ],
      "rules": [
        "Manual Team A and Team B checkboxes remain usable.",
        "A player selected in Team A is disabled in Team B.",
        "A player selected in Team B is disabled in Team A.",
        "Toggling a player into one team removes them from the other team.",
        "Server validation rejects duplicate cross-team membership."
      ]
    },
    "autoBalancing": {
      "serverOnlyFile": "server/team-balancing.ts",
      "apiRoute": "app/api/team-balance/route.ts",
      "clientSends": "availablePlayerIds only",
      "clientReceives": "teamAPlayerIds and teamBPlayerIds only",
      "algorithm": [
        "Resolve private neutral balance weights on the server.",
        "Deduplicate and validate canonical player IDs.",
        "Group by balanceWeight.",
        "Fisher-Yates shuffle groups.",
        "Process weight 3, then 2, then 1.",
        "Keep team-size difference no more than one.",
        "Prefer lower roster size first, then lower accumulated private weight, then random."
      ],
      "privacy": [
        "Do not add balanceWeight to public player objects.",
        "Do not import server/team-balancing.ts into client components.",
        "Do not return weights from /api/team-balance.",
        "Do not display strength, tier, ranking band, balance weight, or team power score in UI."
      ]
    },
    "scorecardDataEntry": {
      "principle": "Easy live-entry scorecard using innings totals, completed-over totals, and manually selected special events.",
      "doesNotRequire": [
        "balls faced",
        "batting strike rate",
        "dot balls",
        "ball-by-ball bowling data",
        "individual fielding chances"
      ],
      "battingInputs": [
        "Did bat",
        "Runs",
        "Out"
      ],
      "bowlingOverInputs": [
        "Bowler selector",
        "Runs conceded",
        "Wickets",
        "Maiden checkbox"
      ],
      "playerEventInputs": [
        "Hat-tricks",
        "Catches",
        "Run-outs",
        "Player of the Match"
      ],
      "performanceRecord": "PlayerMatchPerformance in lib/types/match.ts includes playerId, teamId, played, teamWon, playerOfMatch, didBat, runs, wasOut, wickets, overs, hatTricks, catches, runOuts, stumpings."
    },
    "teamTotals": {
      "rule": "Team total equals sum of selected players' runs only.",
      "ui": "Team A Total and Team B Total are read-only output values.",
      "updatesWhen": [
        "runs change",
        "player added to team",
        "player removed from team",
        "auto-balanced team regenerated",
        "player moved between teams"
      ],
      "serverValidation": "app/api/matches/validate/route.ts recalculates totals via server/match-validation.ts before save/submit mock actions."
    }
  },
  "progressionSystem": {
    "file": "lib/progression.ts",
    "matchXPFormula": {
      "participationXP": "played ? 20 : 0",
      "winXP": "played && teamWon ? 5 : 0",
      "playerOfMatchXP": "playerOfMatch ? 15 : 0",
      "regularBattingXP": "didBat ? Math.min(Math.floor(runs / 2), 30) : 0",
      "fiftyXP": "didBat && runs >= 50 ? 15 : 0",
      "centuryXP": "didBat && runs >= 100 ? 25 : 0",
      "duckPenalty": "didBat && wasOut && runs === 0 ? -8 : 0",
      "wicketXP": "wickets * 10",
      "hatTrickXP": "hatTricks * 25",
      "maidenXP": "overs where maiden or runsConceded === 0, times 5",
      "expensiveOverPenalty": "sum per-over penalties, capped at -20",
      "fieldingXP": "Math.min(catches * 6 + runOuts * 8 + stumpings * 8, 24)",
      "matchXPFloor": "-15"
    },
    "expensiveOverPenalty": {
      "runsConceded >= 30": -12,
      "runsConceded >= 25": -8,
      "runsConceded >= 21": -5,
      "otherwise": 0,
      "totalPenaltyFloor": -20
    },
    "levelProgression": {
      "xpNeededToAdvance": "100 + 50 * currentLevel + 20 * currentLevel * currentLevel",
      "usesCumulativeThresholds": true,
      "achievedLevelCannotDecrease": true,
      "penaltiesCannotDropXPBelowCurrentLevelThreshold": true
    },
    "ratings": {
      "sampleSizeStatuses": {
        "0": "UNRATED",
        "1-2": "SCOUTING",
        "3-7": "PROVISIONAL",
        "8+": "ESTABLISHED"
      },
      "numericDisplayRule": "Only show numeric rating after at least 3 finalised matches.",
      "reliability": "Math.min(finalisedMatches / 8, 1)",
      "displayedRating": "Math.round(50 + reliability * (rawRating - 50))",
      "bladePower": [
        "60% percentile rank of runs per batting innings",
        "25% percentile rank of milestone index",
        "15% percentile rank of duck-avoidance rate"
      ],
      "deliveryThreat": [
        "55% percentile rank of wickets per bowling match",
        "30% reversed percentile rank of bowling economy",
        "15% percentile rank of bowling impact"
      ],
      "fieldReflex": [
        "65% percentile rank of catches per match",
        "35% percentile rank of run-outs per match"
      ]
    }
  },
